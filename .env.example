PORT=4000
NODE_ENV=development

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Production (Render): Postgres — data survives redeploy
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Local / tests only (ignored when DATABASE_URL is set)
DATABASE_PATH=./data/skonga.sqlite

# ── File storage ──
# Default: local disk (OK for dev; ephemeral on Render without disk)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8

# Cloudflare R2 (recommended) or any S3-compatible store
# When these are set, driver becomes "s3" automatically.
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=skonga-uploads
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
#
# Or AWS-style names:
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=uploads
# S3_FORCE_PATH_STYLE=true

SERVICE_TOKEN=

FREE_CHAT_PER_DAY=20
FREE_SCAN_PER_DAY=5
FREE_IMAGE_PER_DAY=2
FREE_RAG_PER_DAY=30

PRO_UNLIMITED=false
PRO_CHAT_PER_DAY=500
PRO_SCAN_PER_DAY=100
PRO_IMAGE_PER_DAY=50
PRO_RAG_PER_DAY=1000
