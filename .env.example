PORT=4000
NODE_ENV=development

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

DATABASE_PATH=./data/skonga.sqlite
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8

# Shared secret with skonga-backend-v2 (USAGE_SERVICE_TOKEN)
# Generate: openssl rand -hex 32
SERVICE_TOKEN=

FREE_CHAT_PER_DAY=20
FREE_SCAN_PER_DAY=5
FREE_IMAGE_PER_DAY=2
FREE_RAG_PER_DAY=30

PRO_UNLIMITED=false
PRO_CHAT_PER_DAY=500
PRO_SCAN_PER_DAY=100
PRO_IMAGE_PER_DAY=50
PRO_RAG_PER_DAY=1000
