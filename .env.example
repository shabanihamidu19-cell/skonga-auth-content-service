PORT=4000
NODE_ENV=development

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Production (Render / Neon): set this — data survives redeploy
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Local / tests only (ignored when DATABASE_URL is set)
DATABASE_PATH=./data/skonga.sqlite

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8

SERVICE_TOKEN=

FREE_CHAT_PER_DAY=20
FREE_SCAN_PER_DAY=5
FREE_IMAGE_PER_DAY=2
FREE_RAG_PER_DAY=30

PRO_UNLIMITED=false
PRO_CHAT_PER_DAY=500
PRO_SCAN_PER_DAY=100
PRO_IMAGE_PER_DAY=50
PRO_RAG_PER_DAY=1000
